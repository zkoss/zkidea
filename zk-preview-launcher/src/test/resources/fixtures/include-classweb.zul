<?xml version="1.0" encoding="UTF-8"?>
<!-- Includes a page via ZK's ~./ classpath-resource notation (resolves from the
     classpath /web/, NOT the docroot). Distinct resolution path from absolute/relative. -->
<zk xmlns="http://www.zkoss.org/2005/zul">
    <window title="Include (~./ classpath src)" border="normal">
        <include src="~./classweb-fragment.zul"/>
        <label value="include host marker"/>
    </window>
</zk>
