<?xml version="1.0" encoding="UTF-8"?>
<!-- P2 (~./ classpath): applies a template from the classpath /web/, not the docroot.
     Sourced from manual-test/src/main/resources/web/classweb-fragment.zul. After the
     resource-root fix (ZulPreviewServerService now hands the module's resource roots to
     the launcher classpath), this is EXPECTED to render "CLASSWEB FRAGMENT CONTENT".
     See MANUAL-apply-include.md. -->
<zk xmlns="http://www.zkoss.org/2005/zul">
    <window title="Apply (~./ classpath templateURI)" border="normal" width="360px">
        <apply templateURI="~./classweb-fragment.zul"/>
        <label value="apply host marker"/>
    </window>
</zk>