<?xml version="1.0" encoding="UTF-8"?>
<!-- P2 display spot-check: a static <apply> must show the applied template's content
     (label + button) inside the window. Headless coverage: ApplyTemplateUriTest. -->
<zk xmlns="http://www.zkoss.org/2005/zul">
    <window title="Apply (static templateURI)" border="normal" width="360px">
        <apply templateURI="/preview/cases/apply-static-template.zul"/>
        <label value="apply host marker"/>
    </window>
</zk>
